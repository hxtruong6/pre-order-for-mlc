# --- preorder4MLC ---------------------------------------------------------

# Results: ignore everything under results/, but allow directory listings
# plus the per-fold evaluation CSVs and the aggregated summary tables.
# Only CSV is tracked — XLSX, figures, and stats are not shipped (regenerable).
results/**
!results/**/
!results/**/evaluation_*.csv
!results/**/*_summary.csv

# Logs (per-dataset stdout/stderr from run.sh)
logs/
slurm_logs/

# Pickle artefacts (training/eval intermediates)
*.pkl

# Editor & IDE
.vscode/
.idea/

# Claude Code: exclude all Claude-related artefacts
.claude/
.mcp.json
CLAUDE.md

# code-review-graph index
.code-review-graph/

# Dataset files are downloaded separately and are not shipped with the package.
*.arff

# Local paper-writing workspaces
overleaf/
paper_revision/

# --- Python ---------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Test / coverage
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml

# Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
.env
.venv
env/
venv/
ENV/
